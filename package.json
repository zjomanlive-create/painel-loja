{
  "name": "painel-loja",
  "version": "1.0.0",
  "description": "Painel de gestão da loja",
  "author": "Painel da Loja",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "web": "npx serve www",
    "build:electron": "electron-builder --win"
  },
  "build": {
    "appId": "com.minhaloja.painel",
    "productName": "Painel da Loja",
    "files": [
      "electron/**/*",
      "www/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "latest",
    "@capacitor/core": "latest",
    "@capacitor/android": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "latest",
    "electron": "latest",
    "electron-builder": "latest"
  }
}
